: "football_dev", "identifier": "anomaly_threshold_sensitivity", "schema": "elementary"}, {"database": "football_dev", "identifier": "dbt_artifacts_hashes", "schema": "elementary"}, {"database": "football_dev", "identifier": "job_run_results", "schema": "elementary"}, {"database": "football_dev", "identifier": "metrics_anomaly_score", "schema": "elementary"}, {"database": "football_dev", "identifier": "model_run_results", "schema": "elementary"}, {"database": "football_dev", "identifier": "monitors_runs", "schema": "elementary"}, {"database": "football_dev", "identifier": "seed_run_results", "schema": "elementary"}, {"database": "football_dev", "identifier": "snapshot_run_results", "schema": "elementary"}], "schema": "elementary"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "3fcf55e0-e651-49bc-8fc0-7836b3b25f15", "level": "debug", "msg": "While listing relations in database=football_dev, schema=elementary, found: data_monitoring_metrics, dbt_columns, dbt_exposures, dbt_groups, dbt_invocations, dbt_metrics, dbt_models, dbt_run_results, dbt_seeds, dbt_snapshots, dbt_sources, dbt_source_freshness_results, dbt_tests, elementary_test_results, metadata, schema_columns_snapshot, test_result_rows, alerts_anomaly_detection, alerts_dbt_models, alerts_dbt_source_freshness, alerts_dbt_tests, alerts_schema_changes, anomaly_threshold_sensitivity, dbt_artifacts_hashes, job_run_results, metrics_anomaly_score, model_run_results, monitors_runs, seed_run_results, snapshot_run_results", "name": "ListRelations", "pid": 27996, "thread": "MainThread", "ts": "2026-09-24T15:11:18.108906Z"}}
