{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n      select\n          column_name,\n          data_type,\n          character_maximum_length,\n          numeric_precision,\n          numeric_scale\n\n      from system.information_schema.columns\n      where table_name = 'dbt_invocations'\n      \n      and lower(table_schema) = 'elementary'\n      \n      \n      and lower(table_catalog) = 'football_dev'\n      \n      order by ordinal_position\n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9fcaee05-540d-4b62-803c-039697def5ee", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n      select\n          column_name,\n          data_type,\n          character_maximum_length,\n          numeric_precision,\n          numeric_scale\n\n      from system.information_schema.columns\n      where table_name = 'dbt_invocations'\n      \n      and lower(table_schema) = 'elementary'\n      \n      \n      and lower(table_catalog) = 'football_dev'\n      \n      order by ordinal_position\n\n  ", "name": "SQLQuery", "pid": 27996, "thread": "MainThread", "ts": "2026-09-24T15:11:24.619864Z"}}
